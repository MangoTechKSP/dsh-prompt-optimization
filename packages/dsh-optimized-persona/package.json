{
  "name": "dsh-optimized-persona",
  "version": "1.1.3",
  "description": "DSH plugin that replaces the deployment prose in DeepSeek Harness system prompt with a Claude Code style working prompt, keeping tool docs, identity and model lines",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "prompts",
    "cordis.patch.yml",
    "test.mjs",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "system-prompt",
    "claude-code"
  ],
  "license": "Apache-2.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MangoTechKSP/dsh-prompt-optimization.git",
    "directory": "packages/dsh-optimized-persona"
  },
  "bugs": {
    "url": "https://github.com/MangoTechKSP/dsh-prompt-optimization/issues"
  },
  "homepage": "https://github.com/MangoTechKSP/dsh-prompt-optimization#readme"
}
